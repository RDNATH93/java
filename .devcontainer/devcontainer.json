{
  "name": "Generative AI Java Development Environment",
  "image": "mcr.microsoft.com/devcontainers/universal:4",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/sshd:1": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-java-pack",
        "vscjava.vscode-spring-initializr",
        "vscjava.vscode-spring-boot-dashboard",
        "github.copilot"
      ],
      "settings": {
        "java.configuration.updateBuildConfiguration": "automatic",
        "java.compile.nullAnalysis.mode": "automatic",
        "java.completion.enabled": true,
        "java.format.enabled": true,
        "java.saveActions.organizeImports": true
      }
    }
  },
  "postCreateCommand": "bash -c 'source $HOME/.sdkman/bin/sdkman-init.sh && sdk install java 25-open && sdk default java 25-open && java -version'"
}
